<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/home_bg_dark">

    <ImageView
            android:id="@+id/topIndiLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/common_indi_line"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:translationY="-4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top Status Bar Area -->
    <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintTop_toTopOf="parent">

        <!-- Light/Dark Mode Toggle Button -->
        <ImageView
                android:id="@+id/btnThemeToggle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="75dp"
                android:layout_marginTop="15dp"
                android:src="@drawable/ic_moon"
                android:contentDescription="Toggle Theme"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                app:tint="#FFFFFF" />

        <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

        <TextClock
                android:id="@+id/textClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:translationY="-5dp"
                android:format24Hour="HH:mm" />
    </LinearLayout>

    <!-- 2x3 Grid for Main Buttons -->
    <GridLayout
            android:id="@+id/gridLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:columnCount="3"
            android:rowCount="2"
            app:layout_constraintWidth_percent="0.85"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toTopOf="@id/bottomBar">

        <!-- Button 1: Radio (Updated with your selector) -->
        <FrameLayout
                android:id="@+id/btnRadio"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true">

            <!-- The Icon: Fills the entire grid cell -->
            <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/selector_radio"
                    android:scaleType="fitXY" />

            <!-- The Text: Floats over the image at the bottom center -->
            <TextView
                    android:id="@+id/btnRadioText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="Radio"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:paddingBottom="12dp" />
        </FrameLayout>

        <!-- Button 2: Media (Prepared for selector_media) -->
        <FrameLayout
                android:id="@+id/btnMedia"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true">

            <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/selector_media"
                    android:scaleType="fitXY"/>

            <TextView
                    android:id="@+id/btnMediaText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="Media"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:paddingBottom="12dp" />
        </FrameLayout>

        <!-- Button 3: Phone (Prepared for selector_phone) -->
        <FrameLayout
                android:id="@+id/btnPhone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true">

            <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/selector_phone"
                    android:scaleType="fitXY" />

            <TextView
                    android:id="@+id/btnPhoneText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="Phone"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:paddingBottom="12dp" />
        </FrameLayout>

        <!-- Button 4: Driving Eco2 (Prepared for selector_eco) -->
        <FrameLayout
                android:id="@+id/btnEco"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true">

            <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/selector_vehicle"
                    android:scaleType="fitXY"/>

            <TextView
                    android:id="@+id/btnEcoText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="Vehicle"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:paddingBottom="12dp" />
        </FrameLayout>

        <!-- Button 5: Nav (Prepared for selector_nav) -->
        <FrameLayout
                android:id="@+id/btnNav"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true">

            <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/selector_navi"
                    android:scaleType="fitXY"/>

            <TextView
                    android:id="@+id/btnNavText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="Nav"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:paddingBottom="12dp" />
        </FrameLayout>

        <!-- Button 6: Settings (Prepared for selector_settings) -->
        <FrameLayout
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true">

            <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/selector_setting"
                    android:scaleType="fitXY"/>

            <TextView
                    android:id="@+id/btnSettingsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="Settings"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:paddingBottom="12dp" />
        </FrameLayout>

    </GridLayout>

    <!-- Bottom Bar (Android Auto) -->
    <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="0dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_android_auto_dark"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="28dp"
            android:paddingEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_android_auto"
                android:contentDescription="Android Auto Icon" />

        <TextView
                android:id="@+id/btnAndroidAutoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:text="Android Auto"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>