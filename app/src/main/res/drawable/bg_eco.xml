<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Gradient fading from dark to the vibrant color -->
    <gradient
            android:startColor="#0000181A"
            android:centerColor="#0000181A"
            android:endColor="#abc54a"
            android:angle="270" />

    <!-- The thin colored border around the button -->
    <stroke
            android:width="1dp"
            android:color="#abc54a" />

    <corners android:radius="0dp" />
</shape>