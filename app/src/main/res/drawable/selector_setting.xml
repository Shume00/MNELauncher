<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State when the user is actively touching the button -->
    <item android:state_pressed="true" android:drawable="@drawable/setting_btn_pressed" />
    <item android:state_enabled="false" android:drawable="@drawable/setting_btn_disable" />
    <item android:state_selected="true" android:drawable="@drawable/setting_btn_selected" />

    <!-- Default state -->
    <item android:drawable="@drawable/setting_btn_normal" />
</selector>